# Required: base URL of your Redmine instance (no trailing slash)
REDMINE_BASE_URL=https://redmine.example.com

# Required: API key from Redmine: My account -> API access key
REDMINE_API_KEY=

# Optional: admin-only impersonation (X-Redmine-Switch-User)
REDMINE_IMPERSONATE_USER=

# If true, block all mutating HTTP methods (POST, PUT, PATCH, DELETE)
REDMINE_READONLY=false

# Allow redmine_request escape-hatch tool (arbitrary REST paths)
REDMINE_ALLOW_RAW_REQUEST=false

# HTTP timeout in milliseconds
REDMINE_HTTP_TIMEOUT_MS=15000

# Max pages when using fetch_all on list endpoints (limit * pages)
REDMINE_MAX_PAGES=20

# Max bytes for attachment download tool (default 5 MiB)
REDMINE_MAX_DOWNLOAD_BYTES=5242880

# Optional: run integration tests (vitest) against a real instance
# REDMINE_INTEGRATION_URL=
# REDMINE_INTEGRATION_API_KEY=
