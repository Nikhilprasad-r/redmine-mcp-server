{
  "name": "redmine-mcp-server",
  "version": "1.0.0",
  "description": "MCP server exposing Redmine REST API as tools (stdio)",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "docker:build": "docker build -t redmine-mcp-server:local .",
    "docker:run": "docker run --rm -i -e REDMINE_BASE_URL -e REDMINE_API_KEY -e REDMINE_READONLY -e REDMINE_ALLOW_RAW_REQUEST -e REDMINE_HTTP_TIMEOUT_MS -e REDMINE_MAX_PAGES -e REDMINE_MAX_DOWNLOAD_BYTES redmine-mcp-server:local",
    "docker:publish": "echo \"Use: docker buildx build --platform linux/amd64,linux/arm64 -t <docker-user>/redmine-mcp-server:<tag> -t <docker-user>/redmine-mcp-server:latest --push .\""
  },
  "keywords": [
    "mcp",
    "redmine",
    "model-context-protocol"
  ],
  "license": "GPL-2.0-or-later",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.19.1",
    "eslint": "^9.39.1",
    "nock": "^14.0.15",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.2",
    "vitest": "^4.1.5"
  }
}
